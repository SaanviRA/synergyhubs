# Runtime settings for the API, installed as /etc/group_app/group_app.env (mode 600).
# Edit, then: sudo systemctl restart group-app-api

# Signs login tokens. Changing it logs everyone out. Generate with: openssl rand -hex 32
JWT_SECRET=

# Same client ID the frontend was built with (VITE_GOOGLE_CLIENT_ID). Required for Google sign-in.
GOOGLE_CLIENT_ID=

# PostgreSQL connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=group_app_db
DB_USER=pguser
DB_PASSWORD=pgpassword

# Browser origins allowed to call the API. Not needed when Nginx serves the frontend and /api
# from the same domain; set it only if the frontend lives on a different origin.
CORS_ORIGINS=

# Folder with the school-guard model for the chat safety check (see DEPLOY.md, "Chat safety check").
# Empty: chat is checked with the self-harm rules only.
MODERATION_MODEL_DIR=
