# Copy to .env for local development. scripts/setup.sh does this and fills in JWT_SECRET.

# --- Frontend (compiled into the browser bundle by Vite at build time) ---
# Google Cloud Console credentials for Sign-In and the Drive Picker (https://console.cloud.google.com)
VITE_GOOGLE_CLIENT_ID=your-oauth-2.0-client-id-here.apps.googleusercontent.com
VITE_GOOGLE_APP_ID=your-google-project-number-here
VITE_GOOGLE_API_KEY=your-developer-api-key-here

# Where the browser reaches the API. Local dev: http://localhost:5001. Production: https://yourdomain.com
VITE_API_URL=http://localhost:5001

# --- Backend ---
# Signs login tokens. Required; the API refuses to start without a strong value.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# PostgreSQL connection (defaults match docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=group_app_db
DB_USER=pguser
DB_PASSWORD=pgpassword

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
